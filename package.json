{
  "name": "nova",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA local-first desktop agent platform",
  "packageManager": "pnpm@9.15.5",
  "type": "module",
  "scripts": {
    "build": "pnpm prepare:memory-client && pnpm -r --if-present build",
    "check:links": "python3 scripts/check-links.py",
    "format": "prettier --write \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"vitest.config.ts\" \"eslint.config.mjs\" \"IMPLEMENTATION_PLAN.md\" \"packages/**/*.{ts,json}\" \"services/**/*.{ts,json}\" \"apps/**/*.{ts,tsx,js,mjs,json}\" \"scripts/**/*.{js,mjs}\"",
    "format:check": "prettier --check \"package.json\" \"pnpm-workspace.yaml\" \"tsconfig*.json\" \"vitest.config.ts\" \"eslint.config.mjs\" \"IMPLEMENTATION_PLAN.md\" \"packages/**/*.{ts,json}\" \"services/**/*.{ts,json}\" \"apps/**/*.{ts,tsx,js,mjs,json}\" \"scripts/**/*.{js,mjs}\"",
    "lint": "eslint .",
    "prepare:memory-client": "pnpm --filter @nova/memory prisma:generate",
    "prepare:memory-test": "node scripts/prepare-memory-test.mjs",
    "install:windows": "node scripts/install-windows.mjs",
    "uninstall:windows": "node scripts/uninstall-windows.mjs",
    "register:windows-service": "node scripts/windows-service.mjs",
    "unregister:windows-service": "node scripts/windows-service.mjs --remove",
    "register:windows-browser-host": "node scripts/windows-browser-native-host.mjs",
    "package:windows": "pnpm --filter @nova/desktop package:win",
    "test": "pnpm --filter @nova/shared build && pnpm prepare:memory-test && pnpm --filter @nova/memory build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm prepare:memory-client && pnpm -r --if-present typecheck",
    "verify": "pnpm check:links && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@prisma/client": "6.19.3",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.2.6"
  }
}
